DB_HOST=localhost
DB_PORT=5432
DB_NAME=almacenamiento_db
DB_USER=almacenamiento_app
DB_PASSWORD=
# Opcional solo para pruebas. En producción usar PostgreSQL.
# DATABASE_URL=sqlite:///./demo.db
APP_ENV=development
COOKIE_SECURE=false
SESSION_HOURS=8
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Proveedor compatible con Chat Completions y herramientas. Sin modelo, IA devuelve estado no configurado.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Demo local aislada: scripts/demo.ps1 configura estas variables temporalmente.
DEMO_MODE=false
# Carpeta de imágenes; por defecto backend/var/uploads.
# UPLOADS_DIR=D:/datos/almacen/imagenes
